[Unit]
Description=Run one on-demand review and terminate the worker
After=network-online.target cloud-final.service docker.service user@1001.service lxd-agent.service
Wants=network-online.target
Requires=docker.service user@1001.service

[Service]
Type=exec
User=root
Group=root
ExecStart=/opt/review-bot/bin/bootstrap

[Install]
WantedBy=cloud-init.target
